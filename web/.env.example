# ─── Supabase ──────────────────────────────────────────────────────────────
# Get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (server only — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Subdomain split origins (Session 15 · hard rule #35) ─────────────────
# Prod: NEXT_PUBLIC_APP_URL=https://app.kieio.com · NEXT_PUBLIC_MARKETING_URL=https://kieio.com
# Dev / preview: both can = http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001
# Legacy single-origin fallback (used when APP/MARKETING URLs unset · pre-split):
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ─── LLM providers ─────────────────────────────────────────────────────────
# Anthropic — Director (Haiku 4.5) + Pro tier (Sonnet 4.6) + Pro Max (Opus 4.7)
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenRouter — all non-Anthropic narrator models (GPT, Gemini, GLM, Llama for adult)
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI — embeddings (text-embedding-3-small) + moderation API
OPENAI_API_KEY=

# ─── Stripe (Phase 4 subscription + Phase 6 KYC) ──────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs (create products in Stripe Dashboard · paste price_xxx ids)
STRIPE_PRICE_ADVENTURER=price_xxx_standard_9_99
STRIPE_PRICE_STORYTELLER=price_xxx_pro_19_99
STRIPE_PRICE_TOPUP_SMALL=price_xxx_topup_5_00
STRIPE_PRICE_TOPUP_MEDIUM=price_xxx_topup_12_50
STRIPE_PRICE_TOPUP_LARGE=price_xxx_topup_40_00

# ─── Observability (Session 16 P-02 · Sentry + PostHog) ───────────────────
# Sentry · error tracking · https://sentry.io/settings/account/api/auth-tokens/
NEXT_PUBLIC_SENTRY_DSN=
# Required for source map upload (CI / prod build only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog · product analytics · https://us.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Cron security (Vercel cron · /api/cron/refresh-free-credits) ─────────
# Vercel auto-injects Authorization: Bearer ${CRON_SECRET} on cron invocations
# Set in Vercel Dashboard · Settings · Cron Jobs · Authentication
CRON_SECRET=
